# Alpaca Trading API Credentials
# Copy this file to .env and fill in your actual credentials
# Get free paper trading credentials at: https://alpaca.markets

# Alpaca Paper Trading API Keys
ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here

# Note: These should be your PAPER trading credentials, NOT live trading
# Paper trading credentials start with "PK" (paper key) and "PS" (paper secret)
